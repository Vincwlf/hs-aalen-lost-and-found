generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Item {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String
  location      String
  room          String?
  incidentDate  DateTime @default(now())
  secretFeature String?
  status        String   @default("LOST") // "LOST", "FOUND", "RESOLVED"
  contact       String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}